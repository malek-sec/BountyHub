# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Flask session signing key — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=REPLACE_ME_with_64_hex_chars

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Telegram alerting (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# Set to 1 only during local development — NEVER in production
FLASK_DEBUG=0

# Set a strong initial admin password on first boot (optional)
# If unset, a random password is printed once to stdout on first run
ADMIN_INIT_PASSWORD=
